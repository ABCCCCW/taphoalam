{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build && cp -R ../backend/uploads dist/uploads && mkdir -p dist/docs && cp ../docs/huong-dan-su-dung.html ../docs/bao-cao-so-do.html dist/docs/",
  "outputDirectory": "frontend/dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/app/**",
      "excludeFiles": "{backend/uploads/**,backend/seeds/**,backend/.venv/**,frontend/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|uploads/|assets/|docs/).*)",
      "destination": "/index.html"
    }
  ]
}
