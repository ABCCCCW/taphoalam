{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build && cp -R ../backend/uploads dist/uploads",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/app/**",
      "excludeFiles": "{backend/uploads/**,backend/seeds/**,backend/.venv/**,frontend/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|uploads/|assets/).*)", "destination": "/index.html" }
  ]
}
